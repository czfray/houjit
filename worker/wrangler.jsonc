{
    "name": "houjit",
    "main": "worker.js",
    "compatibility_date": "2026-11-21",

    "kv_namespaces": [
        {
            "binding": "HOUJIT_KV",
            "id": "6206f151e2814ae18b56ae644edbd356"
        }
    ],

    "triggers": {
        "crons": ["*/3 * * * *"]
    },

    "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }

}